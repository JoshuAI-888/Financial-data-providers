# Secrets — never commit
.env
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Data cache (API responses) — keep repo light; regenerate via run.py
data/raw/*.json
data/raw/**/*.json

# Keep the generated report and demo cache out unless explicitly added
